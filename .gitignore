# 本地开发库（用 npx prisma migrate deploy + seed 重建，不入库）
prisma/.local/

prisma/backups/
prisma/restores/
screens/
artifacts/

# local scratch (docx extraction, remote helper scripts)
.temp/

# agent team runtime state
.agent-teams/

# 服务器与面板凭据，只留在本机；绝不能进仓库或发布包
线上测试文档资料.txt
.git-commit-msg.txt
.msg.txt

# Runtime snapshots and credentials belong in shared storage, never source control.
/private-data/
