      "assertions": [
        {"kind": "http-status", "target": "POST turns（旧 revision）", "expect": 409},
        {"kind": "state", "target": "已提交消息", "expect": "未被覆盖"}
      ],
      "dependsOn": ["M4 回合服务（revision CAS）"]
    },
