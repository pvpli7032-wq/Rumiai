      "id": "EV-A02-001",
      "title": "同一 requestId 的回合重试返回相同回合，不重复生成结算",
      "acceptance": ["A02"],
      "ownerWorkflow": "W06/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "skeleton",
      "description": "规划书第 19 章：同一 requestId 重试返回相同回合，不再次预留或生成；唯一键与事务保证应用内只结算一次。",
      "steps": [
        {"actor": "user", "action": "带 requestId 发送回合", "expect": "回合 COMMITTED"},
        {"actor": "user", "action": "用同一 requestId 重试", "expect": "返回同一 turnId"}
      ],
      "assertions": [
        {"kind": "state", "target": "StoryTurn / aiCall / 账本", "expect": "各恰有一条，无二次结算"}
      ],
      "dependsOn": ["M4 回合服务（幂等）"]
    },
    {
