      "acceptance": ["A02"],
      "ownerWorkflow": "W06/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "skeleton",
      "description": "规划书第 16 章：冲突返回 409 并刷新，不覆盖对方进度。",
      "steps": [
        {"actor": "tab-1", "action": "以旧 expectedRevision 写入", "expect": "409"},
        {"actor": "tab-2", "action": "以当前 revision 写入", "expect": "成功"}
