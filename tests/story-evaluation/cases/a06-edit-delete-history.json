{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "EV-A06-001",
      "title": "编辑第 N 回合使 N 及之后的派生事件与快照失效",
      "acceptance": ["A06"],
      "ownerWorkflow": "W06/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "skeleton",
      "description": "规划书第 16 章：在同一应用事务中使 N 及之后派生事件、快照和完成结果失效，并提升实例 revision。",
      "steps": [
        {"actor": "user", "action": "编辑历史回合 N 的用户消息", "expect": "N 之后事件全部失效"},
        {"actor": "system", "action": "检查 revision", "expect": "已提升"}
      ],
      "assertions": [
        {"kind": "state", "target": "StoryEvent/StoryCheckpoint（sourceTurn > N）", "expect": "状态为已失效"}
      ],
      "dependsOn": ["M4 历史失效事务"]
    },
    {
      "id": "EV-A06-002",
      "title": "删除消息同事务失效并提升 revision",
      "acceptance": ["A06"],
      "ownerWorkflow": "W06/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "skeleton",
      "description": "规划书第 16 章：失效规则由 stories 执行，与 conversations 的消息删除同事务，不存在窗口期。",
      "steps": [
        {"actor": "user", "action": "删除第 N 回合消息", "expect": "派生状态同事务失效"}
      ],
      "assertions": [
        {"kind": "state", "target": "revision", "expect": "原子提升，无中间态"}
      ],
      "dependsOn": ["M4 历史失效事务"]
    },
    {
      "id": "EV-A06-003",
      "title": "重建使用最近有效检查点，旧摘要不再注入模型",
      "acceptance": ["A06"],
      "ownerWorkflow": "W06/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "skeleton",
      "description": "规划书第 16 章：重建使用最近有效检查点及保留消息，不能将旧摘要继续注入模型。",
      "steps": [
        {"actor": "system", "action": "失效后重建上下文", "expect": "以最近有效 checkpoint 为基"}
      ],
      "assertions": [
        {"kind": "state", "target": "buildContext 输入", "expect": "不含已失效摘要"}
      ],
      "dependsOn": ["M4 buildContext"]
    },
    {
      "id": "EV-A06-004",
      "title": "历史修改后新剧情不引用已失效旧后果",
      "acceptance": ["A06"],
      "ownerWorkflow": "W08",
      "verificationTier": "model-simulated",
      "modelPolicy": "simulated",
      "status": "skeleton",
      "description": "规划书第 09/13 章：不得一边展示新对话，一边把已删除的旧情节继续作为记忆。",
      "steps": [
        {"actor": "user", "action": "修改关键消息并重生成", "expect": "旧后果失效"},
        {"actor": "user", "action": "继续对话", "expect": "回复不引用旧后果"}
      ],
      "assertions": [
        {"kind": "model-output", "target": "回复", "expect": "无旧情节引用"}
      ],
      "dependsOn": ["M4 闭环"]
    },
    {
      "id": "EV-A06-005",
      "title": "故事会话中旧发送/重生成/编辑/删除不得绕过状态机",
      "acceptance": ["A06", "A02"],
      "ownerWorkflow": "W06/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "skeleton",
      "description": "story-run-service.test.mjs 已覆盖拒绝分支（409）；回合编排实现后本用例转为回归口径：旧路径仍不可绕过。",
      "steps": [
        {"actor": "user", "action": "对故事会话调用旧 SEND/REGENERATE/编辑/删除", "expect": "按 M4 后契约处理，不得绕过状态写入"}
      ],
      "assertions": [
        {"kind": "state", "target": "派生状态", "expect": "与故事状态机一致"}
      ],
      "dependsOn": ["M3-3 分流", "M4 回合服务"]
    },
    {
      "id": "EV-A06-006",
      "title": "回合序号定义因果先后，不依赖 createdAt 时间字符串",
      "acceptance": ["A06"],
      "ownerWorkflow": "W05/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "skeleton",
      "description": "规划书第 16 章：同一时刻消息缺少稳定顺序；故事消息采用明确回合序号与消息关联。",
      "steps": [
        {"actor": "runner", "action": "构造同 createdAt 的多回合", "expect": "失效范围按序号判定"}
      ],
      "assertions": [
        {"kind": "state", "target": "失效范围", "expect": "不因时间戳相同而漏失效"}
      ],
      "dependsOn": ["M4 历史失效事务"]
    },
    {
      "id": "EV-A06-007",
      "title": "用户纠错：修正事实使依赖错误事实的摘要失效",
      "acceptance": ["A06"],
      "ownerWorkflow": "W06/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "skeleton",
      "description": "规划书第 10 章：用户修正保存修订来源，并使依赖错误事实的摘要失效；校正不改模板隐藏真相（第 18 章 corrections）。",
      "steps": [
        {"actor": "user", "action": "提交事件修正（当时交出的是复印件）", "expect": "修订来源保存"},
        {"actor": "system", "action": "检查依赖摘要", "expect": "失效或重建"}
      ],
      "assertions": [
        {"kind": "state", "target": "依赖该事实的 checkpoint", "expect": "已失效"}
      ],
      "dependsOn": ["M4 corrections 端点"]
    },
    {
      "id": "EV-A06-008",
      "title": "纠错后模型输出遵守修正后事实",
      "acceptance": ["A06"],
      "ownerWorkflow": "W08",
      "verificationTier": "model-simulated",
      "modelPolicy": "simulated",
      "status": "skeleton",
      "description": "纠错的端到端验证：修正后继续对话，回复遵守修正后事实而非旧事实。",
      "steps": [
        {"actor": "user", "action": "纠错后继续对话", "expect": "上下文注入修正后事实"}
      ],
      "assertions": [
        {"kind": "model-output", "target": "回复", "expect": "遵守修正后事实"}
      ],
      "dependsOn": ["M4 闭环"]
    }
  ]
}
