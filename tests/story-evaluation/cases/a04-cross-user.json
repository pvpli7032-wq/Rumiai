{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "EV-A04-001",
      "title": "猜测 run 标识读不到他人私密内容",
      "acceptance": [
        "A04"
      ],
      "ownerWorkflow": "W05/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "implemented",
      "description": "规划书第 18 章：读写均校验用户所有权；不存在或无权一律 404，不区分存在性。 执行器口径（已落地）：他人与猜测的 run 标识均 404（不泄露存在性），列表接口不含他人实例。",
      "steps": [
        {
          "actor": "stranger",
          "action": "GET 他人 run id",
          "expect": "404"
        }
      ],
      "assertions": [
        {
          "kind": "http-status",
          "target": "GET /api/story-runs/{id}",
          "expect": 404
        }
      ],
      "dependsOn": [
        "story-runs API（已上线）"
      ]
    },
    {
      "id": "EV-A04-002",
      "title": "猜测 event/share 标识不可读取私密派生数据",
      "acceptance": [
        "A04"
      ],
      "ownerWorkflow": "W07/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "implemented",
      "description": "规划书第 24 章：作者不能读取读者私人聊天；事件仅暴露已确认、未失效且属于本会话的数据。",
      "steps": [
        {
          "actor": "stranger",
          "action": "枚举他人 event/share 标识",
          "expect": "一律 404 或空"
        }
      ],
      "assertions": [
        {
          "kind": "state",
          "target": "响应体",
          "expect": "无他人私密字段"
        }
      ],
      "dependsOn": [
        "M4 事件查询端点",
        "W07 分享关联"
      ]
    },
    {
      "id": "EV-A04-003",
      "title": "DTO 白名单：隐藏剧情、提示词、stateJson、lease 不输出",
      "acceptance": [
        "A04"
      ],
      "ownerWorkflow": "W05/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "implemented",
      "description": "规划书第 18 章：StoryRunView 不含隐藏事实、完整提示词、密钥与他人信息。story-run-service.test.mjs 已覆盖，本用例保留在评测口径内防回归。 执行器口径（已落地）：公开视图序列化不含 SECRET_PLOT/PRIVATE_PERSONA/PRIVATE_PROMPT/stateJson/leaseOwner/createRequestId；确认事件只出公开摘要。",
      "steps": [
        {
          "actor": "owner",
          "action": "读取 run 详情",
          "expect": "序列化结果不含敏感键"
        }
      ],
      "assertions": [
        {
          "kind": "state",
          "target": "JSON 序列化",
          "expect": "不含 hiddenFacts/prompt/stateJson/lease/requestKey"
        }
      ],
      "dependsOn": [
        "story-runs API（已上线）"
      ]
    },
    {
      "id": "EV-A04-004",
      "title": "分享快照与私密数据分离，公开快照不含备注与身份资料",
      "acceptance": [
        "A04",
        "A09"
      ],
      "ownerWorkflow": "W07/W08",
      "verificationTier": "domain",
      "modelPolicy": "none",
      "status": "implemented",
      "description": "规划书第 24 章：公开帖子只保存用户预览确认的快照；读者不继承分享者私人经历。",
      "steps": [
        {
          "actor": "owner",
          "action": "创建含私密备注的实例并分享选中片段",
          "expect": "publicSnapshot 仅含选中内容"
        },
        {
          "actor": "reader",
          "action": "通过分享进入自己的故事",
          "expect": "不继承分享者经历"
        }
      ],
      "assertions": [
        {
          "kind": "state",
          "target": "publicSnapshot",
          "expect": "无私密备注/身份资料字段"
        }
      ],
      "dependsOn": [
        "W07 StoryShare"
      ]
    }
  ]
}
