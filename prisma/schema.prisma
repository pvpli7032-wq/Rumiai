  createdBy             String           @map("created_by")
  createdAt             DateTime         @default(now()) @map("created_at")
  merchant              PaymentMerchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  currentFor            PaymentMerchant? @relation("MerchantCurrentRevision")
  orders                PaymentOrder[]

  @@unique([merchantId, revision])
  @@index([merchantId, createdAt])
  @@map("payment_merchant_revisions")
}

/// One full refund per order. PROCESSING/UNKNOWN reserve coins until confirmed.
model PaymentRefund {
  id               String           @id @default(cuid())
  paymentOrderId   String           @unique @map("payment_order_id")
  refundNo         String           @unique @map("refund_no")
  providerRefundNo String?          @unique @map("provider_refund_no")
  actorId          String           @map("actor_id")
  approvedById     String?          @map("approved_by_id")
  approvedAt       DateTime?        @map("approved_at")
  approvalReason   String?          @map("approval_reason")
  rejectedById     String?          @map("rejected_by_id")
  rejectedAt       DateTime?        @map("rejected_at")
  rejectionReason  String?          @map("rejection_reason")
  lastActionById   String?          @map("last_action_by_id")
  reason           String
  amountCnyCents   Int              @map("amount_cny_cents")
  coinAmount       Int              @map("coin_amount")
  status           String           @default("PROCESSING")
  errorCode        String?          @map("error_code")
  attemptedAt      DateTime         @default(now()) @map("attempted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  completedAt      DateTime?        @map("completed_at")
  paymentOrder     PaymentOrder     @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  debit            CoinTransaction? @relation("RefundDebit")
  release          CoinTransaction? @relation("RefundRelease")

  @@index([status, createdAt])
  @@map("payment_refunds")
}

