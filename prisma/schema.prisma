  tags           String?
  isPublic       Boolean  @default(true) @map("is_public")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isPublic])
  @@map("universes")
}

/// Comments on a character's page. The report taxonomy already carries a COMMENT target
/// type, so this is the surface it was written for.
///
/// `parentId` gives one level of replies. It is deliberately not a general tree: an
/// unbounded thread needs its own moderation and pagination story, and a reply-to-a-reply
/// reads the same as a reply in a list this short.
model Comment {
  id          String    @id @default(cuid())
  characterId String    @map("character_id")
  authorId    String    @map("author_id")
  parentId    String?   @map("parent_id")
  body        String
  likeCount   Int       @default(0) @map("like_count")
  /// Soft-hidden by moderation. The row stays so a reply keeps its parent and the
  /// reporter can still see what they filed against.
  hiddenAt    DateTime? @map("hidden_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  character Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]

  @@index([characterId, createdAt])
  @@index([parentId])
  @@map("comments")
}

/// One like per person per comment, enforced by the unique index rather than by a
/// read-then-write, which is how the mission rewards were double-collected.
model CommentLike {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  commentId String   @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

/// Accepted generation attempts; no prompt or response text is stored here.
model AiDailyUsage {
  userId String @map("user_id")
  day    String
  count  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("ai_daily_usage")
}

model AiCall {
  id               String        @id @default(cuid())
  /// 匿名玩法（Mirror 公开生成）没有账号，成本仍必须计量，所以这两列可空。
  userId           String?       @map("user_id")
  conversationId   String?       @map("conversation_id")
  /// 业务任务类型：chat / story / mirror / dispute_verdict / memory_summary。
  taskType         String?       @map("task_type")
  /// 匿名主体的服务端归属标识（不信任客户端传入的用户 ID）。
  anonymousSubject String?       @map("anonymous_subject")
  operation        String
  status           String        @default("STARTED")
  model            String?
  attempts         Int           @default(0)
  inputTokens      Int?          @map("input_tokens")
  outputTokens     Int?          @map("output_tokens")
  estimatedCost    Float?        @map("estimated_cost")
  modelPriceId     String?       @map("model_price_id")
  modelPrice       AiModelPrice? @relation(fields: [modelPriceId], references: [id], onDelete: SetNull)
  currency         String
  errorCode        String?       @map("error_code")
  startedAt        DateTime      @default(now()) @map("started_at")
  finishedAt       DateTime?     @map("finished_at")
  durationMs       Int?          @map("duration_ms")
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([currency, startedAt])
  @@index([taskType, startedAt])
  @@map("ai_calls")
}

/// Daily cost thresholds stored in their native currency; never converted implicitly.
