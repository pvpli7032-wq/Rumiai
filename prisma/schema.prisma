  isActive        Boolean            @default(false) @map("is_active")
  isDefault       Boolean            @default(false) @map("is_default")
  defaultSlot     String?            @unique @map("default_slot")
  isFallback      Boolean            @default(false) @map("is_fallback")
  sortOrder       Int                @default(0) @map("sort_order")
  timeoutMs       Int                @default(60000) @map("timeout_ms")
  maxRetries      Int                @default(1) @map("max_retries")
  maxOutputTokens Int                @default(800) @map("max_output_tokens")
  lastCheckAt     DateTime?          @map("last_check_at")
  lastCheckStatus String?            @map("last_check_status")
  version         Int                @default(0)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  prices          AiModelPrice[]
  coinPrices      ModelCoinPrice[]
  characters      CharacterAiModel[]

  @@unique([providerId, modelCode])
  @@index([isActive, isDefault, isFallback, sortOrder, id])
  @@map("ai_models")
}

/// Append-only provider price history. Rates are stored as millionths of a currency unit per million tokens.
model AiModelPrice {
  id                     String   @id @default(cuid())
  modelId                String   @map("model_id")
  model                  AiModel  @relation(fields: [modelId], references: [id], onDelete: Restrict)
  currency               String
  inputPerMillionMicros  BigInt   @map("input_per_million_micros")
  outputPerMillionMicros BigInt   @map("output_per_million_micros")
  effectiveAt            DateTime @map("effective_at")
  source                 String
  reason                 String
  createdBy              String   @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")
  calls                  AiCall[]

  @@unique([modelId, effectiveAt])
  @@map("ai_model_prices")
}

/// Creating a circle does not automatically subscribe its owner.
model Circle {
  id           String                        @id @default(cuid())
  name         String
  description  String
  tags         String?
  ownerId      String?                       @map("owner_id")
  universeId   String?                       @map("universe_id")
  status       String                        @default("ACTIVE")
  isFeatured   Boolean                       @default(false) @map("is_featured")
  createdAt    DateTime                      @default(now()) @map("created_at")
  updatedAt    DateTime                      @updatedAt @map("updated_at")
  owner        User?                         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  universe     Universe?                     @relation(fields: [universeId], references: [id], onDelete: SetNull)
  members      CircleMember[]
  restrictions CircleMembershipRestriction[]
  posts        Post[]

  @@index([status, createdAt])
  @@index([status, isFeatured, createdAt, id])
  @@index([status, updatedAt, id])
  @@map("circles")
}

model CircleMember {
  circleId  String   @map("circle_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([circleId, userId])
  @@index([userId, createdAt])
  @@index([circleId, createdAt, userId])
  @@map("circle_members")
}

model CircleMembershipRestriction {
  circleId  String   @map("circle_id")
  userId    String   @map("user_id")
  actorId   String   @map("actor_id")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user      User     @relation("CircleRestrictedUser", fields: [userId], references: [id], onDelete: Cascade)
  actor     User     @relation("CircleRestrictionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@id([circleId, userId])
  @@index([userId])
  @@index([circleId, createdAt, userId])
  @@map("circle_membership_restrictions")
}

model Post {
  id          String        @id @default(cuid())
  circleId    String        @map("circle_id")
  authorId    String        @map("author_id")
  characterId String?       @map("character_id")
  content     String
  status      String        @default("VISIBLE")
  isPinned    Boolean       @default(false) @map("is_pinned")
  isFeatured  Boolean       @default(false) @map("is_featured")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  circle      Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  character   Character?    @relation(fields: [characterId], references: [id], onDelete: SetNull)
  media       PostMedia[]
  likes       PostLike[]
  comments    PostComment[]

  @@index([circleId, status, createdAt])
  @@index([circleId, status, isPinned, isFeatured, createdAt, id])
  @@index([status, updatedAt, id])
  @@index([circleId, status, updatedAt, id])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostMedia {
  id       String @id @default(cuid())
  postId   String @map("post_id")
  url      String
  position Int    @default(0)
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@map("post_media")
}

model PostLike {
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_likes")
}

/// Independent from character comments; community visibility applies here.
model PostComment {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  content   String
  imageUrl  String?  @map("image_url")
  status    String   @default("VISIBLE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, status, createdAt])
  @@index([status, updatedAt, id])
  @@map("post_comments")
}

model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
  @@map("follows")
}

/// Target identifiers survive deletion for audit history.
model ModerationAction {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  action     String
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@map("moderation_actions")
}

model CommunityAppeal {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  reason     String
  status     String    @default("OPEN")
  resolution String?
  reviewedBy String?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("community_appeals")
}

/// 故事模板：一个可体验的故事起点。V1 才有；V0 用的是随版本发布的静态配置。
model StoryTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  status    String
  ownerId   String?  @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner    User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  versions StoryTemplateVersion[]

  @@index([status, updatedAt, id])
  @@map("story_templates")
}

/// 模板的不可变发布版本。已发布版本不再改，改动出新版本。
model StoryTemplateVersion {
  id                    String    @id @default(cuid())
  templateId            String    @map("template_id")
  version               Int
  locale                String
  /// 结构化定义。SQLite 无 Json 类型，落库前由应用层按版本化 schema 校验。
  definitionJson        String    @map("definition_json")
  /// 发布时的角色快照，避免角色改动后已发布版本的说法漂移。
  characterSnapshotJson String    @map("character_snapshot_json")
  publishedAt           DateTime? @map("published_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  template StoryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  runs     StoryRun[]

  @@unique([templateId, version, locale])
  @@index([locale, publishedAt])
  @@map("story_template_versions")
}

/// 故事运行实例。与 Conversation 一对一；没有实例的会话就是普通自由聊天。
model StoryRun {
  id                          String    @id @default(cuid())
  userId                      String    @map("user_id")
  conversationId              String    @unique @map("conversation_id")
  templateVersionId           String    @map("template_version_id")
  chapterKey                  String    @map("chapter_key")
  status                      String    @default("ACTIVE")
  /// 乐观版本号：每个状态变更事务成功时递增一次，写入前比对。
  revision                    Int       @default(0)
  lastCommittedTurnNo         Int       @default(0) @map("last_committed_turn_no")
  stateProcessedThroughTurnNo Int       @default(0) @map("state_processed_through_turn_no")
  /// 已确认状态快照。SQLite 下是经 schema 校验的 JSON 文本。
  stateJson                   String    @map("state_json")
  /// 创建幂等键：同一用户同一键重试不会建出第二个实例。
  createRequestId             String    @map("create_request_id")
  /// 唯一活动回合槽。非空表示此实例正在生成，同一实例至多一个回合。
  activeTurnId                String?   @unique @map("active_turn_id")
  startedAt                   DateTime  @map("started_at")
  endedAt                     DateTime? @map("ended_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  templateVersion StoryTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  turns           StoryTurn[]
  events          StoryEvent[]
  checkpoints     StoryCheckpoint[]
  shares          StoryShare[]

  @@unique([userId, createRequestId])
  @@index([userId, updatedAt, id])
  @@index([templateVersionId])
  @@map("story_runs")
}

/// 一次故事回合。承担幂等、单实例串行与状态整理的持久租约。
model StoryTurn {
  id                 String    @id @default(cuid())
  runId              String    @map("run_id")
  turnNo             Int       @map("turn_no")
  requestId          String    @map("request_id")
  /// 规范化请求的 hash：区分「同键重试」与「同键不同内容」。
  requestHash        String    @map("request_hash")
  status             String    @default("ACCEPTED")
  inputMessageId     String?   @unique @map("input_message_id")
  assistantMessageId String?   @unique @map("assistant_message_id")
  operation          String
  stateStatus        String    @default("PENDING") @map("state_status")
  stateAttempts      Int       @default(0) @map("state_attempts")
  errorCode          String?   @map("error_code")
  startedAt          DateTime  @map("started_at")
  committedAt        DateTime? @map("committed_at")
  /// 后台状态整理的持久租约。进程重启后过期任务可被重新认领。
  leaseOwner         String?   @map("lease_owner")
  leaseExpiresAt     DateTime? @map("lease_expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  run              StoryRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  inputMessage     Message?     @relation("StoryInputMessage", fields: [inputMessageId], references: [id], onDelete: SetNull)
  assistantMessage Message?     @relation("StoryAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  events           StoryEvent[]

  @@unique([runId, requestId])
  @@unique([runId, turnNo])
  @@index([runId, stateStatus, leaseExpiresAt])
  @@index([runId, turnNo, status])
  @@map("story_turns")
}

/// 已确认/待确认的故事事实。用 type 区分，不为每种类型另建引擎。
model StoryEvent {
  id              String    @id @default(cuid())
  runId           String    @map("run_id")
  sourceTurnId    String    @map("source_turn_id")
  chapterKey      String    @map("chapter_key")
  /// FACT / PROMISE / RELATIONSHIP / CHAPTER_RESULT
  type            String
  status          String    @default("PENDING")
  payloadJson     String    @map("payload_json")
  sourceMessageId String?   @map("source_message_id")
  /// 历史被修改时置位：失效而非删除，便于解释与排查。
  invalidatedAt   DateTime? @map("invalidated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  run           StoryRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceTurn    StoryTurn @relation(fields: [sourceTurnId], references: [id], onDelete: Cascade)
  sourceMessage Message?  @relation("StorySourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([runId, sourceTurnId, status])
  @@index([runId, chapterKey, status, createdAt])
  @@index([sourceMessageId])
  @@map("story_events")
}

/// 状态快照。失效后保留，不删除。
model StoryCheckpoint {
  id            String    @id @default(cuid())
  runId         String    @map("run_id")
  throughTurnNo Int       @map("through_turn_no")
  revision      Int
  stateJson     String    @map("state_json")
  invalidatedAt DateTime? @map("invalidated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  run StoryRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, throughTurnNo, revision])
  @@index([runId, invalidatedAt, throughTurnNo])
  @@map("story_checkpoints")
}

/// 用户选定 2–6 条本人故事消息的分享快照（W07）。状态机 PUBLISHED→WITHDRAWN 单向；
/// 撤回只改本行，不动 run 本体；读者路径对 WITHDRAWN 一律 404，不暴露存在性。
/// publishedPostId 预留与现有帖子服务的关联，本阶段不写入（读者入口走社区体系）。
model StoryShare {
  id                     String    @id @default(cuid())
  runId                  String    @map("run_id")
  userId                 String    @map("user_id")
  title                  String
  /// 用户勾选的消息 ID 数组 JSON；创建时校验全部属于本 run 且已提交。
  selectedMessageIdsJson String    @map("selected_message_ids_json")
  /// 创建时一次固化的公开快照（模板/章节公开标题 + 选中片段），读者只读快照，不读 run 本体。
  snapshotJson           String    @map("snapshot_json")
  /// PUBLISHED / WITHDRAWN
  status                 String    @default("PUBLISHED")
  publishedPostId        String?   @map("published_post_id")
  withdrawnAt            DateTime? @map("withdrawn_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  run                StoryRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyTurnSelection StoryShareTurn[]

  @@index([runId])
  @@index([userId, createdAt])
  @@map("story_shares")
}

/// V0 场景漏斗事实。每个用户每个场景会话每个节点最多一条，只记事实不记内容；
/// 不声明关系字段以保持本文件只增不改的约定，会话归属由写入服务校验。
model SceneFunnelEvent {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  conversationId String   @map("conversation_id")
  sceneId        String   @map("scene_id")
  event          String
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, conversationId, event])
  @@index([createdAt])
  @@map("scene_funnel_events")
}

/// 分享快照与消息的固定对应（创建时写入，消息删除随之置空，快照本身不改）。
model StoryShareTurn {
  id        String   @id @default(cuid())
  shareId   String   @map("share_id")
  messageId String?  @map("message_id")
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  share   StoryShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  message Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([shareId, position])
  @@index([messageId])
  @@map("story_share_turns")
}

// ==========================================
// 商业改造（2026-10-21，V3 实施版）
// 迁移：20261021180000_commercial_platform
// ==========================================

/// 运营公共参数。value 存校验后的 JSON 字符串，读取方按 registry 的类型解析。
/// 每项只有一个主编辑位置：设置中心。
model OperationSetting {
  key       String   @id
  group     String
  value     String
  version   Int      @default(0)
  updatedBy String   @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("operation_settings")
}

/// 用户特例：只有额度、计费模式、折扣倍率与指定玩法次数允许覆盖。
/// 到期后自动回落公共值（读取时判断 expires_at，不做后台清理任务）。
model UserSettingOverride {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  key       String
  value     String
  expiresAt DateTime? @map("expires_at")
  version   Int       @default(0)
  updatedBy String    @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("user_setting_overrides")
}

/// 设置变更历史。恢复历史值时写一条新记录，不原地改旧记录。
model SettingRevision {
  id         String   @id @default(cuid())
  key        String
  scope      String // GLOBAL, USER
  userId     String?  @map("user_id")
  oldValue   String?  @map("old_value")
  newValue   String   @map("new_value")
  operatorId String   @map("operator_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@index([scope, createdAt])
  @@map("setting_revisions")
}

/// 模型收费币价（用户侧），与供应商成本价 AiModelPrice 分开存，各自有历史。
model ModelCoinPrice {
  id            String   @id @default(cuid())
  modelId       String   @map("model_id")
  coinsPerReply Int      @map("coins_per_reply")
  effectiveAt   DateTime @map("effective_at")
  version       Int      @default(0)
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  model         AiModel  @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@unique([modelId, effectiveAt])
  @@map("model_coin_prices")
}

/// 一次生成请求的计费单。状态机：HELD → SETTLED / RELEASED，结果不明为 UNKNOWN。
/// 价格快照在预扣时固化，后续改价不影响已开始请求。
model GenerationCharge {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  requestId         String    @map("request_id")
  operation         String // CHAT_SEND, CHAT_REGENERATE, STORY_TURN, MIRROR, DISPUTE_VERDICT, MEMORY_SUMMARY
  status            String    @default("HELD") // HELD, SETTLED, RELEASED, UNKNOWN
  coins             Int       @default(0)
  priceSnapshotJson String    @map("price_snapshot_json")
  allowanceSource   String?   @map("allowance_source") // FREE_QUOTA, PAID
  conversationId    String?   @map("conversation_id")
  messageId         String?   @map("message_id")
  aiCallId          String?   @map("ai_call_id")
  heldAt            DateTime  @default(now()) @map("held_at")
  settledAt         DateTime? @map("settled_at")
  releasedAt        DateTime? @map("released_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, requestId])
  @@index([status, heldAt])
  @@map("generation_charges")
}

/// 每日免费次数。free_reserved 是并发预占，成功后并入 free_used。
model UserDailyAllowance {
  userId         String @map("user_id")
  day            String
  freeUsed       Int    @default(0) @map("free_used")
  freeReserved   Int    @default(0) @map("free_reserved")
  /// 当日已用掉的「免费取消」次数；只在「已输出即收费」策略下消耗。
  freeCancelUsed Int    @default(0) @map("free_cancel_used")
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("user_daily_allowances")
}

/// 他眼中的你：一次生成结果。share_id 为公开分享标识，删除后公开接口 404。
model MirrorResult {
  id               String    @id @default(cuid())
  shareId          String    @unique @map("share_id")
  userId           String?   @map("user_id")
  anonymousSubject String?   @map("anonymous_subject")
  characterId      String    @map("character_id")
  answersJson      String    @map("answers_json")
  title            String
  observationsJson String    @map("observations_json")
  quote            String
  indicesJson      String    @map("indices_json")
  rawJson          String?   @map("raw_json")
  status           String    @default("READY") // READY, FAILED, HIDDEN, EXPIRED
  chargeId         String?   @map("charge_id")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("mirror_results")
}

/// 评理案例。复用帖子承载评论点赞举报，这里只存案例、规则快照、票数与结案结果。
model DisputeCase {
  id               String        @id @default(cuid())
  postId           String        @unique @map("post_id")
  authorId         String        @map("author_id")
  characterId      String?       @map("character_id")
  excerptJson      String        @map("excerpt_json")
  claim            String
  ruleSnapshotJson String        @map("rule_snapshot_json")
  deadlineAt       DateTime      @map("deadline_at")
  voteCount        Int           @default(0) @map("vote_count")
  closeStatus      String        @default("OPEN") @map("close_status") // OPEN, CLOSING, CLOSED
  verdictJson      String?       @map("verdict_json")
  closedAt         DateTime?     @map("closed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  author           User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes            DisputeVote[]

  @@index([closeStatus, deadlineAt])
  @@index([authorId, createdAt])
  @@map("dispute_cases")
}

/// 一人一票，可改票有限次；唯一键保证并发下不会出现两张票。
model DisputeVote {
  id          String      @id @default(cuid())
  caseId      String      @map("case_id")
  userId      String      @map("user_id")
  choice      String // AUTHOR, OTHER, SPLIT
  reviseCount Int         @default(0) @map("revise_count")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  case        DisputeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId, createdAt])
  @@map("dispute_votes")
}

/// 普通聊天的滚动摘要，一个会话一行；关闭记忆后不再更新与注入。
model ConversationMemory {
  id               String       @id @default(cuid())
  conversationId   String       @unique @map("conversation_id")
  summary          String
  coveredMessageId String?      @map("covered_message_id")
  version          Int          @default(0)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_memories")
}

/// 从对话里确认的关键事实。source_message_id 不设外键：消息删除由失效逻辑显式处理。
model MemoryFact {
  id              String   @id @default(cuid())
  conversationId  String   @map("conversation_id")
  userId          String   @map("user_id")
  text            String
  sourceMessageId String?  @map("source_message_id")
  pinned          Boolean  @default(false)
  status          String   @default("ACTIVE") // ACTIVE, INVALID, DELETED
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([userId, createdAt])
  @@map("memory_facts")
}

/// 统一后台任务：持久化、可重入、带租约。与 StoryTurn 的租约语义一致但互不干扰。
model BackgroundTask {
  id         String    @id @default(cuid())
  kind       String
  subjectId  String    @map("subject_id")
  status     String    @default("PENDING") // PENDING, RUNNING, DONE, FAILED
  attempts   Int       @default(0)
  nextRunAt  DateTime  @default(now()) @map("next_run_at")
  leaseOwner String?   @map("lease_owner")
  leaseUntil DateTime? @map("lease_until")
  lastError  String?   @map("last_error")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([kind, subjectId])
  @@index([status, nextRunAt])
  @@map("background_tasks")
}

/// 站内通知：审核结果、回复提醒、到账、活动结果共用一套。
model Notification {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  type       String
  title      String
  body       String?
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// 新玩法漏斗事件（Mirror / 评理）。既有 SceneFunnelEvent 继续服务故事，不双写同一事件。
model ProductEvent {
  id               String   @id @default(cuid())
  name             String
  subjectKey       String?  @map("subject_key")
  userId           String?  @map("user_id")
  anonymousSubject String?  @map("anonymous_subject")
  propertiesJson   String?  @map("properties_json")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@map("product_events")
}
