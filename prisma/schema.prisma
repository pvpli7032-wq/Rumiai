}

/// Immutable provider credentials/settings referenced by orders at creation time.
model PaymentMerchantRevision {
  id                    String           @id @default(cuid())
  merchantId            String           @map("merchant_id")
  revision              Int
  merchantNo            String           @map("merchant_no")
  apiBaseUrl            String           @map("api_base_url")
