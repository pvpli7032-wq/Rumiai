/// A shared world (จักรวาล) that groups several characters into one setting
model Universe {
  circles        Circle[]
  id             String   @id @default(cuid())
  name           String
  /// Short hook shown under the name on cards
  tagline        String?
  description    String
  imageUrl       String?  @map("image_url")
  creatorId      String?  @map("creator_id")
  /// How many characters live in this world
  characterCount Int      @default(0) @map("character_count")
  chatCount      Int      @default(0) @map("chat_count")
