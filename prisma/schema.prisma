// xingban/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODELS
// ==========================================

/// User account model managing profile, auth credentials, tier, and economy state
model User {
  id                   String    @id @default(cuid())
  username             String    @unique
  email                String    @unique
  passwordHash         String    @map("password_hash")
  avatarUrl            String?   @map("avatar_url")
  /// Public display name shown above the @username on creator cards
  displayName          String?   @map("display_name")
  tier                 String    @default("ROOKIE") // ROOKIE, PRO, MASTER, LEGEND, EPIC, MYTHIC
  /// Cached creator-leaderboard counters (see prisma/seed-creators.ts)
  followerCount        Int       @default(0) @map("follower_count")
  characterCount       Int       @default(0) @map("character_count")
  messageCount         Int       @default(0) @map("message_count")
  chatCount            Int       @default(0) @map("chat_count")
  universeMessageCount Int       @default(0) @map("universe_message_count")
  universeChatCount    Int       @default(0) @map("universe_chat_count")
  /// Followers gained in the last seven days — powers the "มาแรงสัปดาห์นี้" tab
  weeklyFollowerGain   Int       @default(0) @map("weekly_follower_gain")
  /// Bumped on logout to invalidate every token issued before it. Tokens carry this
  /// value, so a leaked one stops working as soon as the user signs out.
  tokenVersion         Int       @default(0) @map("token_version")
  deletedAt            DateTime? @map("deleted_at")
  suspendedAt          DateTime? @map("suspended_at")
  suspensionReason     String?   @map("suspension_reason")
  accountVersion       Int       @default(0) @map("account_version")
  lastLoginAt          DateTime? @map("last_login_at")
  lastActiveAt         DateTime? @map("last_active_at")
  communityBannedAt    DateTime? @map("community_banned_at")
  communityBanReason   String?   @map("community_ban_reason")
  /// Reader preferences from the chat panel. bannedWords is a newline-separated list
  /// ("คำที่ไม่ต้องการ"); shortcuts is JSON for the quick-insert buttons.
  bannedWords          String?   @map("banned_words")
  readingMode          Boolean   @default(false) @map("reading_mode")
  shortcuts            String?
  coins                Int       @default(100)
  streakCount          Int       @default(0) @map("streak_count")
  lastCheckin          DateTime? @map("last_checkin")
  /// 新手引导选中的兴趣标签（JSON 数组）；为空表示还没选过。
  interestsJson        String?   @map("interests_json")
  /// 引导完成时间；为空表示还没走完或跳过。
  onboardedAt          DateTime? @map("onboarded_at")
  /// 本人的邀请码；分享链接带它进入注册。
  inviteCode           String?   @unique @map("invite_code")
  /// 注册时归属的邀请人。只做归属与发奖判断，不建外键关系（不参与级联）。
  invitedByUserId      String?   @map("invited_by_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  circles                   Circle[]
  circleMemberships         CircleMember[]
  circleRestrictions        CircleMembershipRestriction[] @relation("CircleRestrictedUser")
  circleRestrictionsApplied CircleMembershipRestriction[] @relation("CircleRestrictionActor")
  posts                     Post[]
  postLikes                 PostLike[]
  postComments              PostComment[]
  following                 Follow[]                      @relation("Following")
  followers                 Follow[]                      @relation("Followers")
  moderationActions         ModerationAction[]
  siteContentDrafts         SiteContentDraft[]
  siteContentRevisions      SiteContentRevision[]
  appeals                   CommunityAppeal[]

  // Relationships
  characters         Character[]           @relation("CreatedCharacters")
  conversations      Conversation[]
  storyTemplates     StoryTemplate[]
  storyRuns          StoryRun[]
  storyShares        StoryShare[]
  activityDays       UserActivityDay[]
  checkins           Checkin[]
  giftsSent          Gift[]                @relation("UserGiftsSent")
  coinTransactions   CoinTransaction[]
  paymentOrders      PaymentOrder[]
  userMissions       UserMission[]
  characterLikes     CharacterLike[]
  characterBookmarks CharacterBookmark[]
  reportsFiled       Report[]              @relation("ReportsFiled")
  questProgress      UserCharacterQuest[]
  aiCalls            AiCall[]
  aiDailyUsage       AiDailyUsage[]
  accountClosure     AccountClosure?
  consents           UserConsent[]
  uploadAssets       UploadAsset[]
  adminOperator      AdminOperator?
  comments           Comment[]
  commentLikes       CommentLike[]
  settingOverrides   UserSettingOverride[]
  dailyAllowances    UserDailyAllowance[]
  generationCharges  GenerationCharge[]
  mirrorResults      MirrorResult[]
  disputeCases       DisputeCase[]
  disputeVotes       DisputeVote[]
  memoryFacts        MemoryFact[]
  notifications      Notification[]
  productEvents      ProductEvent[]

  @@index([createdAt, id])
  @@index([suspendedAt, deletedAt])
  @@index([invitedByUserId])
  @@map("users")
}

model AdminOperator {
  userId      String                @id @map("user_id")
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  enabled     Boolean               @default(true)
  version     Int                   @default(0)
  assignments AdminRoleAssignment[]
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@map("admin_operators")
}

model AdminRole {
  id          String                @id @default(cuid())
  code        String                @unique
  name        String
  system      Boolean               @default(false)
  version     Int                   @default(0)
  permissions AdminRolePermission[]
  assignments AdminRoleAssignment[]
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@map("admin_roles")
}

model AdminRolePermission {
  roleId     String    @map("role_id")
  permission String
  role       AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("admin_role_permissions")
}

model AdminRoleAssignment {
  userId    String        @map("user_id")
  roleId    String        @map("role_id")
  operator  AdminOperator @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role      AdminRole     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now()) @map("created_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("admin_role_assignments")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String   @map("actor_id")
  action    String
  targetId  String   @map("target_id")
  reason    String
  changes   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetId, createdAt])
  @@map("admin_audit_logs")
}

/// Current operator-configured registration requirements. Legal text remains in the CMS.
model CompliancePolicy {
  id               String   @id @default("primary")
  ageGateEnabled   Boolean  @default(false) @map("age_gate_enabled")
  minimumAge       Int?     @map("minimum_age")
  agePolicyVersion String?  @map("age_policy_version")
  termsVersion     String?  @map("terms_version")
  privacyVersion   String?  @map("privacy_version")
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("compliance_policies")
}

model SiteCertificateStatus {
  id             String    @id @default("primary")
  hostname       String?
  port           Int?
  status         String    @default("NOT_CHECKED")
  verified       Boolean   @default(false)
  validFrom      DateTime? @map("valid_from")
  validUntil     DateTime? @map("valid_until")
  checkedAt      DateTime? @map("checked_at")
  errorCode      String?   @map("error_code")
  fingerprint256 String?

  @@map("site_certificate_status")
}

model MaintenancePolicy {
  id                String   @id @default("primary")
  enabled           Boolean  @default(false)
  message           String   @default("系统维护中，暂时无法提交操作，请稍后重试。")
  retryAfterSeconds Int      @default(300) @map("retry_after_seconds")
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("maintenance_policies")
}

/// Immutable registration consent records; stores policy versions, never IP or birth date.
model UserConsent {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  policyType    String   @map("policy_type")
  policyVersion String   @map("policy_version")
  source        String   @default("REGISTER")
  acceptedAt    DateTime @default(now()) @map("accepted_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, policyType, policyVersion])
  @@index([policyType, policyVersion, acceptedAt])
  @@index([userId, acceptedAt])
  @@map("user_consents")
}

model AccountClosure {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  fileUrlsJson String    @map("file_urls_json")
  status       String    @default("PENDING_FILES")
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("account_closures")
}

model UploadAsset {
  id        String   @id @default(cuid())
  /// Original uploading account; `siteOwned` records the asset's current business owner.
  ownerId   String   @map("owner_id")
  siteOwned Boolean  @default(false) @map("site_owned")
  url       String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@map("upload_assets")
}

/// Character model for AI persona (both user-created and system featured characters)
model Character {
  communityPosts       Post[]
  id                   String             @id @default(cuid())
  name                 String
  /// Short hook shown on cards in the explore page
  tagline              String?
  personality          String
  background           String
  greeting             String?
  avatarUrl            String?            @map("avatar_url")
  creatorId            String?            @map("creator_id")
  isPublic             Boolean            @default(false) @map("is_public")
  publicationRequested Boolean            @default(false) @map("publication_requested")
  reviewStatus         String             @default("DRAFT") @map("review_status")
  reviewReason         String?            @map("review_reason")
  copyrightStatement   String?            @map("copyright_statement")
  reviewedBy           String?            @map("reviewed_by")
  reviewedAt           DateTime?          @map("reviewed_at")
  chatCount            Int                @default(0) @map("chat_count")
  /// Shown with the "Only on 星伴" badge on cards
  isExclusive          Boolean            @default(false) @map("is_exclusive")
  /// Comma-separated feature emojis rendered on the card (e.g. "☺️,🎹")
  badges               String?
  /// Comma-separated tag keys (e.g. "Female,NC,นอกใจ")
  tags                 String?
  /// Persona template for the player character, shown under "บทบาท" — the live site
  /// ships a fill-in-the-blanks profile the user adopts.
  roleTemplate         String?            @map("role_template")
  /// Opening situation, shown under "สถานการณ์".
  scenario             String?
  /// Cached counters the detail header shows: ไลก์ / แชท / ข้อความ / ของขวัญ.
  /// chatCount already exists; likes and gifts are also derivable from their tables,
  /// but the header reads them on every card so they are denormalised here.
  likeCount            Int                @default(0) @map("like_count")
  messageCount         Int                @default(0) @map("message_count")
  giftCount            Int                @default(0) @map("gift_count")
  /// 18+ content, which the live site warns about above the fold.
  isAdult              Boolean            @default(false) @map("is_adult")
  /// Starting relationship, shown as "ค่าความสัมพันธ์เริ่มต้น": a status label plus
  /// two meters (romance and intimacy).
  ///
  /// These are NOT percentages. The live chat page shows a romance value of 1100 with
  /// its bar about half filled, so the fill is relative to the band of the current
  /// status tier rather than to a 0-100 range. Only non-negative is enforced here; the
  /// tier thresholds that drive the bar are not known.
  relationshipStatus   String?            @map("relationship_status")
  initialRomance       Int                @default(0) @map("initial_romance")
  initialIntimacy      Int                @default(0) @map("initial_intimacy")
  aiModelsRestricted   Boolean            @default(false) @map("ai_models_restricted")
  aiModelScopeVersion  Int                @default(0) @map("ai_model_scope_version")
  allowedAiModels      CharacterAiModel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  creator       User?               @relation("CreatedCharacters", fields: [creatorId], references: [id], onDelete: SetNull)
  conversations Conversation[]
  giftsReceived Gift[]              @relation("CharacterGiftsReceived")
  images        CharacterImage[]
  emojis        CharacterEmoji[]
  supportCast   SupportCharacter[]
  likes         CharacterLike[]
  bookmarks     CharacterBookmark[]
  quests        CharacterQuest[]
  comments      Comment[]

  @@index([creatorId])
  @@index([isPublic])
  @@index([reviewStatus, updatedAt, id])
  @@map("characters")
}

model CharacterAiModel {
  characterId String    @map("character_id")
  modelKey    String    @map("model_key")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  model       AiModel   @relation(fields: [modelKey], references: [key], onDelete: Restrict)

  @@id([characterId, modelKey])
  @@index([modelKey])
  @@map("character_ai_models")
}

/// Extra pictures behind the main one — the detail header pages through them ("1/5").
model CharacterImage {
  id          String   @id @default(cuid())
  characterId String   @map("character_id")
  url         String
  /// IMAGE or VIDEO — the panel lists both under "รูปภาพและวิดีโอ".
  kind        String   @default("IMAGE")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, sortOrder])
  @@map("character_images")
}

/// One picture per emotion, shown in the "อิโมจิตัวละคร" strip. The live site uses
/// happy / sad / angry / embarrassed / confident / blank.
model CharacterEmoji {
  id          String @id @default(cuid())
  characterId String @map("character_id")
  emotion     String
  url         String
  sortOrder   Int    @default(0) @map("sort_order")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, emotion])
  @@map("character_emojis")
}

/// Secondary cast listed under "ตัวละครสนับสนุน", each with its own portrait and notes.
model SupportCharacter {
  id          String  @id @default(cuid())
  characterId String  @map("character_id")
  name        String
  avatarUrl   String? @map("avatar_url")
  description String
  sortOrder   Int     @default(0) @map("sort_order")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, sortOrder])
  @@map("support_characters")
}

/// A like is per person, so it needs a row rather than only a counter — otherwise the
/// same account could like a character repeatedly.
model CharacterLike {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  characterId String   @map("character_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([characterId])
  @@map("character_likes")
}

/// The bookmark button in the detail header.
model CharacterBookmark {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  characterId String   @map("character_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([userId])
  @@map("character_bookmarks")
}

/// Per-character quests, shown as "ภารกิจ (4)" on the detail dialog. The existing
/// Mission model is platform-wide; these belong to one character.
model CharacterQuest {
  id               String   @id @default(cuid())
  characterId      String   @map("character_id")
  title            String
  description      String?
  rewardCoins      Int      @default(0) @map("reward_coins")
  requiredMessages Int      @default(1) @map("required_messages")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  character Character            @relation(fields: [characterId], references: [id], onDelete: Cascade)
  progress  UserCharacterQuest[]

  @@index([characterId, sortOrder])
  @@map("character_quests")
}

/// One row per reader per quest, so a reward can only be collected once.
model UserCharacterQuest {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  questId     String    @map("quest_id")
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest CharacterQuest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@map("user_character_quests")
}

/// A moderation report. A platform carrying adult user-generated content needs a way
/// for readers to flag it, so this is deliberately broad: any target type, the same
/// categories the live site offers, and the extra fields its copyright form collects.
model Report {
  id              String   @id @default(cuid())
  reporterId      String   @map("reporter_id")
  /// CHARACTER, USER, COMMENT, POST, UNIVERSE or MESSAGE.
  targetType      String   @map("target_type")
  targetId        String   @map("target_id")
  /// One of the categories in community/report-types.ts.
  category        String
  /// Narrows an inappropriateImage report: realPerson, explicit, violent or other.
  imageReason     String?  @map("image_reason")
  details         String
  /// Submitted assistant reply retained as evidence even if its chat is deleted.
  evidenceContent String?  @map("evidence_content")
  /// Copyright claims carry provenance the other categories do not.
  workTitle       String?  @map("work_title")
  relationship    String?
  sourceLink      String?  @map("source_link")
  contactType     String?  @map("contact_type")
  contactValue    String?  @map("contact_value")
  /// OPEN, REVIEWING, ACTIONED or DISMISSED.
  status          String   @default("OPEN")
  createdAt       DateTime @default(now()) @map("created_at")

  reporter User @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([status])
  @@map("reports")
}

/// Conversation container between a User and a Character
model Conversation {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  characterId        String    @map("character_id")
  title              String?
  /// Relationship state belongs to the conversation, not the character: the live chat
  /// page shows these moving as you talk, and seeds them from the character's initial
  /// values. A user can hold several conversations with one character, each at its own
  /// stage.
  relationshipStatus String?   @map("relationship_status")
  romance            Int       @default(0)
  intimacy           Int       @default(0)
  /// The "โหมดความสัมพันธ์ (ทดลอง)" switch, per chat.
  relationshipMode   Boolean   @default(true) @map("relationship_mode")
  /// Overrides AI_MODEL for this chat only, chosen from a server-side allowlist so a
  /// reader cannot point the shared provider quota at an arbitrary model.
  aiModel            String?   @map("ai_model")
  /// Free-text notes the reader keeps for this chat ("โน้ตตัวละคร").
  notes              String?
  /// Set when the chat is moved out of the sidebar list ("แชทที่จัดเก็บ").
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relationships
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages  Message[]
  /// 只有从故事入口开始的会话才有实例；历史自由聊天保持 null，继续走原聊天路径。
  storyRun  StoryRun?
  /// 普通聊天的滚动摘要；故事会话走既有 StoryCheckpoint，不复用这张表。
  memory    ConversationMemory?

  @@index([userId])
  @@index([characterId])
  @@index([userId, characterId])
  @@index([userId, archivedAt])
  @@map("conversations")
}

/// Chat message history inside a conversation
model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  role           String // USER, ASSISTANT, SYSTEM
  content        String
  /// Set when the reader taps the thumbs-up on a reply.
  likedAt        DateTime? @map("liked_at")
  /// A picture generated alongside the reply, as the live greeting message carries.
  imageUrl       String?   @map("image_url")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relationships
  conversation        Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// 故事回合对消息的引用。消息被删除时置空而不是级联：回合本身是幂等与恢复的
  /// 凭据，不能因为一条消息被编辑就消失。
  storyInputTurns     StoryTurn[]      @relation("StoryInputMessage")
  storyAssistantTurns StoryTurn[]      @relation("StoryAssistantMessage")
  storyEvents         StoryEvent[]     @relation("StorySourceMessage")
  storyShareTurns     StoryShareTurn[]

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

/// Daily check-in activity log for tracking user streak and reward distribution
model Checkin {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  checkedInAt DateTime @default(now()) @map("checked_in_at")
  coinsEarned Int      @map("coins_earned")
  streakDay   Int      @map("streak_day")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([checkedInAt])
  @@map("checkins")
}

/// Gift transaction sent by a user to support a character (used for Gift Leaderboard)
model Gift {
  id          String   @id @default(cuid())
  senderId    String   @map("sender_id")
  characterId String   @map("character_id")
  catalogId   String?  @map("catalog_id")
  amount      Int
  giftType    String   @default("rose") @map("gift_type")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relationships
  sender    User             @relation("UserGiftsSent", fields: [senderId], references: [id], onDelete: Cascade)
  character Character        @relation("CharacterGiftsReceived", fields: [characterId], references: [id], onDelete: Cascade)
  catalog   GiftCatalogItem? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([characterId])
  @@index([createdAt])
  @@map("gifts")
}

/// Server-priced gift options; Gift.amount remains the immutable historical price snapshot.
model GiftCatalogItem {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  emoji       String   @default("🎁")
  coinPrice   Int      @map("coin_price")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  gifts       Gift[]

  @@index([isActive, sortOrder])
  @@map("gift_catalog_items")
}

/// Ledger tracking all coin adjustments (purchases, rewards, spent)
model CoinTransaction {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  sourceKey       String   @default("OTHER") @map("source_key")
  paymentOrderId  String?  @unique @map("payment_order_id")
  refundId        String?  @unique @map("refund_id")
  refundReleaseId String?  @unique @map("refund_release_id")
  amount          Int
  type            String // PURCHASE, EARNED, SPENT
  description     String?
  /// 聊天计费：同一条费用单的 HOLD（负数）/ RELEASE（正数）各只允许一行。
  /// 既有流水这两列为 NULL，不参与唯一约束。
  chargeId        String?  @map("charge_id")
  chargeAction    String?  @map("charge_action") // HOLD, SETTLE, RELEASE
  /// 奖励发放的唯一业务键（例如评理参与奖「caseId:userId」），同一键只发一次。
  rewardKey       String?  @unique @map("reward_key")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relationships
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentOrder  PaymentOrder?  @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  refund        PaymentRefund? @relation("RefundDebit", fields: [refundId], references: [id], onDelete: Restrict)
  refundRelease PaymentRefund? @relation("RefundRelease", fields: [refundReleaseId], references: [id], onDelete: Restrict)

  @@unique([chargeId, chargeAction])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([sourceKey, createdAt])
  @@map("coin_transactions")
}

/// A server-priced EZFP checkout. Coin and CNY amounts are immutable snapshots;
/// paymentOrderId on CoinTransaction gives each order at most one coin credit.
model PaymentOrder {
  id                 String                   @id @default(cuid())
  orderNo            String                   @unique @map("order_no")
  idempotencyKey     String                   @map("idempotency_key")
  userId             String                   @map("user_id")
  packageId          String?                  @map("package_id")
  packageCoins       Int                      @map("package_coins")
  packageBonus       Int                      @map("package_bonus")
  coinAmount         Int                      @map("coin_amount")
  amountCnyCents     Int                      @map("amount_cny_cents")
  currency           String                   @default("CNY")
  status             String                   @default("PENDING")
  provider           String                   @default("EZFP")
  merchantRevisionId String?                  @map("merchant_revision_id")
  merchantRevision   PaymentMerchantRevision? @relation(fields: [merchantRevisionId], references: [id], onDelete: Restrict)
  providerTradeNo    String?                  @unique @map("provider_trade_no")
  providerPayType    String?                  @map("provider_pay_type")
  providerPayInfo    String?                  @map("provider_pay_info")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  paidAt             DateTime?                @map("paid_at")

  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinTransaction    CoinTransaction?
  refund             PaymentRefund?
  callbackEvents     PaymentCallbackEvent[]
  reconciliationRows PaymentReconciliationEntry[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([merchantRevisionId])
  @@map("payment_orders")
}

/// Minimal audit trail for authenticated payment notifications. Raw callback payloads are never stored.
model PaymentCallbackEvent {
  id              String       @id @default(cuid())
  paymentOrderId  String       @map("payment_order_id")
  provider        String
  providerTradeNo String       @map("provider_trade_no")
  outcome         String
  reasonCode      String?      @map("reason_code")
  receivedAt      DateTime     @default(now()) @map("received_at")
  paymentOrder    PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  @@index([paymentOrderId, receivedAt])
  @@index([provider, receivedAt])
  @@map("payment_callback_events")
}

/// Bounded, low-cardinality callback rejection monitoring. Raw notification data is never stored.
model PaymentCallbackAlertSample {
  id          String   @id @default(cuid())
  provider    String
  minuteStart DateTime @map("minute_start")
  reasonCode  String   @map("reason_code")
  firstSeenAt DateTime @map("first_seen_at")
  lastSeenAt  DateTime @map("last_seen_at")

  @@unique([provider, minuteStart, reasonCode])
  @@index([minuteStart, provider])
  @@map("payment_callback_alert_samples")
}

/// Immutable imported channel statement and local order reconciliation result.
model PaymentReconciliationBatch {
  id                String                       @id @default(cuid())
  provider          String                       @default("EZFP")
  sourceSha256      String                       @unique @map("source_sha256")
  importedById      String                       @map("imported_by_id")
  importReason      String                       @map("import_reason")
  rowCount          Int                          @map("row_count")
  matchedRowCount   Int                          @map("matched_row_count")
  exceptionRowCount Int                          @map("exception_row_count")
  grossCnyCents     BigInt                       @map("gross_cny_cents")
  feeCnyCents       BigInt                       @map("fee_cny_cents")
  periodStart       DateTime                     @map("period_start")
  periodEnd         DateTime                     @map("period_end")
  createdAt         DateTime                     @default(now()) @map("created_at")
  rows              PaymentReconciliationEntry[]

  @@index([createdAt])
  @@map("payment_reconciliation_batches")
}

model PaymentReconciliationEntry {
  id                     String                     @id @default(cuid())
  batchId                String                     @map("batch_id")
  entrySource            String                     @default("STATEMENT") @map("entry_source")
  lineNumber             Int?                       @map("line_number")
  providerTradeNo        String?                    @map("provider_trade_no")
  orderNo                String                     @map("order_no")
  grossCnyCents          Int?                       @map("gross_cny_cents")
  feeCnyCents            Int?                       @map("fee_cny_cents")
  paidAt                 DateTime                   @map("paid_at")
  matchStatus            String                     @map("match_status")
  exceptionCode          String?                    @map("exception_code")
  paymentOrderId         String?                    @map("payment_order_id")
  internalAmountCnyCents Int?                       @map("internal_amount_cny_cents")
  internalOrderStatus    String?                    @map("internal_order_status")
  createdAt              DateTime                   @default(now()) @map("created_at")
  batch                  PaymentReconciliationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  paymentOrder           PaymentOrder?              @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@unique([batchId, lineNumber])
  @@index([batchId, matchStatus])
  @@index([providerTradeNo])
  @@index([orderNo])
  @@map("payment_reconciliation_entries")
}

/// One authenticated user activity per UTC day, used for privacy-minimal retention cohorts.
model UserActivityDay {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  activityDate DateTime @map("activity_date")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
  @@index([activityDate, userId])
  @@map("user_activity_days")
}

/// Mutable channel identity points at immutable, encrypted configuration revisions.
model PaymentCheckoutPolicy {
  id        String   @id
  enabled   Boolean
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_checkout_policy")
}

model PaymentMerchant {
  id                String                    @id @default(cuid())
  name              String                    @unique
  provider          String                    @default("EZFP")
  environment       String                    @default("PRODUCTION")
  isActive          Boolean                   @default(false) @map("is_active")
  activeSlot        String?                   @unique @map("active_slot")
  currentRevisionId String?                   @unique @map("current_revision_id")
  version           Int                       @default(0)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  revisions         PaymentMerchantRevision[]
  currentRevision   PaymentMerchantRevision?  @relation("MerchantCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)

  @@index([provider, environment, isActive])
