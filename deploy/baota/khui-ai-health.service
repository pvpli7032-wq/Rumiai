[Unit]
Description=Khui AI HTTPS and database health check
After=network-online.target

[Service]
Type=oneshot
User=www
Group=www
# 指向 shared/bin 的固定副本，不跟发布目录走：发布切换后无需改这里。
# 部署时把 scripts/check-site-health.mjs 复制到该路径（脚本没有项目依赖）。
WorkingDirectory=/www/wwwroot/khui-ai/shared
ExecStart=/usr/bin/node /www/wwwroot/khui-ai/shared/bin/check-site-health.mjs
TimeoutStartSec=20
NoNewPrivileges=true
