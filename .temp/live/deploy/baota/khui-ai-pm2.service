[Unit]
Description=Khui AI isolated PM2 manager
After=network.target

[Service]
Type=forking
User=www
Group=www
Environment=PM2_HOME=/www/wwwroot/khui-ai/shared/pm2
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
PIDFile=/www/wwwroot/khui-ai/shared/pm2/pm2.pid
ExecStart=/usr/bin/pm2 resurrect
ExecReload=/usr/bin/pm2 reload all
ExecStop=/usr/bin/pm2 kill
Restart=on-failure

[Install]
WantedBy=multi-user.target
