# 星伴 M1 内部测试版配置（不要提交包含真实密钥的 .env）
DATABASE_URL="file:./dev.db"
# Server-only upload storage; blank keeps public/uploads. Set together with DATABASE_URL after recovery.
UPLOADS_DIRECTORY=""
# Generate a unique random secret of at least 32 characters before production use.
JWT_SECRET=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.a6api.com/v1"
AI_MODEL="gpt-6-luna"
AI_FALLBACK_MODELS=""
# 64 hexadecimal characters; back up securely and retain the same value to decrypt provider keys stored in SQLite.
AI_PROVIDER_ENCRYPTION_KEY=""
AI_MAX_TOKENS="800"
AI_HISTORY_TURNS="20"
# 无密钥的开发环境可显式切换 false 测试模拟 AI；生产永远不使用模拟 AI。
DISABLE_MOCK_AI="true"
# 只允许开发环境模拟充值；生产端即使 true 也返回 503。
ALLOW_SIMULATED_PURCHASES="true"
# EZFP V2 global server kill switch. Enable only after package CNY prices and a formal merchant are configured.
# These credential fields support legacy environment routing; new merchant credentials belong in the encrypted admin store.
EZFP_ENABLED="false"
EZFP_REFUNDS_ENABLED="false"
EZFP_PID=""
EZFP_MERCHANT_PRIVATE_KEY=""
EZFP_PLATFORM_PUBLIC_KEY=""
# Local mock-server override is accepted only in non-production and only for localhost.
EZFP_API_BASE_URL=""
# Required only when storing merchant credentials in the admin database. Keep stable and back it up securely.
PAYMENT_MERCHANT_ENCRYPTION_KEY=""
CHAT_RATE_LIMIT="30"
CHAT_RATE_WINDOW_MS="60000"
CHAT_DAILY_LIMIT="200"
UPLOAD_RATE_LIMIT="20"
UPLOAD_RATE_WINDOW_MS="600000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
TEST_BASE_URL="http://localhost:3000"

# Comma-separated user IDs, configured by operator; never accepted from client.
MODERATOR_USER_IDS=""

# M2 upstream request budget, milliseconds. Retries happen only before reply content.
AI_CONNECT_TIMEOUT_MS="10000"
AI_REQUEST_TIMEOUT_MS="60000"
AI_STREAM_IDLE_TIMEOUT_MS="15000"
AI_MAX_RETRIES="1"
# Optional per-million-token prices for AI_PRICE_MODEL (not a provider bill).
# Empty means unknown; never fill an invented model price.
AI_PRICE_MODEL="gpt-6-luna"
AI_INPUT_PRICE_PER_MILLION=""
AI_OUTPUT_PRICE_PER_MILLION=""
AI_PRICE_CURRENCY="USD"
# Finance reports are separate from content-moderation permissions. User IDs only.
PAYMENT_ADMIN_USER_IDS=
# Optional legacy UTC daily budgets, e.g. {"USD":{"site":10,"user":1}}
# Compatibility fallback until database budgets are saved in /admin/ai/costs. Amounts are not model prices.
AI_DAILY_COST_BUDGETS=
# Explicit opt-in only. Stops NEW calls at recorded cost thresholds or unknown completed costs.
# Not a reservation or an exact bill ceiling: already admitted calls continue and may overshoot.
# Enabling requires a valid budget for AI_PRICE_CURRENCY and valid model prices.
# No chat coin charging is enabled.
AI_BUDGET_CIRCUIT_BREAKER="false"
