{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "tsBuildInfoFile": "./artifacts/typecheck.tsbuildinfo"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build/types/**/*.ts",
    ".next-t28/types/**/*.ts",
    ".next-t28b/types/**/*.ts",
    ".next-validation-build/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-t28x/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "artifacts",
    ".next",
    ".next-build",
    ".next-validation-build",
    ".temp"
  ]
}
