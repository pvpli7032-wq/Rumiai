{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@api/*": ["./apps/api/src/*"],
      "@admin/*": ["./apps/admin/src/*"],
      "@web/*": ["./apps/web/src/*"],
      "@/components/*": ["./apps/web/src/components/*"],
      "@/app/*": ["./apps/web/src/app/*"],
      "@rumiai/ui": ["./packages/ui/src/index.ts"],
      "@rumiai/ui/*": ["./packages/ui/src/*"],
      "@rumiai/contracts/*": ["./packages/contracts/src/*"],
      "@rumiai/backend/*": ["./packages/backend/src/*"],
      "@/*": ["./apps/web/src/*"]
    },
    "tsBuildInfoFile": "./.next/cache/typecheck.tsbuildinfo"
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "database/**/*.ts",
    "tailwind.config.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/**/.next*/**"
  ]
}
