{
  "name": "xingban-ai-community",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:community": "tsx prisma/seed-community.ts",
    "test": "tsx tests/runner.ts",
    "test:m0": "node --experimental-strip-types --test tests/launch-safety.test.mjs tests/verify-baseline.test.mjs tests/m0-route-behavior.test.cjs",
    "audit:m0": "node scripts/verify-baseline.mjs --root . --mode development",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:real-ai": "node scripts/verify-real-ai.mjs",
    "db:seed:site": "tsx prisma/seed-site.ts",
    "db:studio": "prisma studio",
    "db:init": "node scripts/initialize-db.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "ops:closure-files": "node --import tsx scripts/retry-closure-files.mjs",
    "test:m5:backup": "node --test tests/sqlite-backup.test.mjs",
    "test:m5:export": "node --import tsx --test tests/account-data-export.test.mjs",
    "test:m5:closure": "node --import tsx --test tests/account-closure.test.mjs tests/logger-privacy.test.mjs",
    "test:auth-config": "node --import tsx --test tests/auth-configuration.test.mjs",
    "test:m5:closure:browser": "node scripts/verify-account-closure-browser.mjs",
    "test:m5:export:browser": "node scripts/verify-account-export-browser.mjs",
    "typecheck": "tsc --noEmit",
    "test:m1:mobile": "node scripts/verify-m1-mobile.mjs",
    "test:m1:pwa": "node scripts/verify-m1-pwa.mjs",
    "test:m1:debug": "node scripts/verify-m1-debug.mjs",
    "test:m1:history": "node scripts/verify-m1-history.mjs",
    "test:m2:roles": "node scripts/verify-m2-roles.mjs",
    "test:m2:browser": "node scripts/verify-m2-browser.mjs",
    "test:m2:review": "node scripts/verify-m2-review.mjs",
    "test:m2:ai": "node scripts/verify-m2-ai.mjs",
    "test:m2:chat": "node scripts/verify-m2-chat.mjs",
    "test:m2:context": "node --test tests/m2-context.test.cjs",
    "test:m3:circles": "node scripts/verify-m3-circles.mjs",
    "test:m3:posts": "node scripts/verify-m3-posts.mjs",
    "test:m3:follow": "node scripts/verify-m3-follow.mjs",
    "test:m3:moderation": "node scripts/verify-m3-moderation.mjs",
    "test:m3:content": "node scripts/verify-m3-content.mjs",
    "test:m4:ezfp:unit": "node --import tsx --test tests/ezfp-signature.test.mjs",
    "test:m4:ezfp": "node --import tsx --test tests/ezfp-signature.test.mjs tests/ezfp-route-integration.test.mjs",
    "test:m4:ezfp:browser": "node scripts/verify-m4-payment-browser.mjs",
    "test:m4:finance:browser": "node scripts/verify-m4-finance-browser.mjs",
    "test:m4:budget": "node --import tsx --test tests/ai-budget-report.test.mjs",
    "test:m4:metrics": "node --import tsx --test tests/ai-cost-report.test.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "lucide-react": "0.468.0",
    "next": "15.5.27",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.19",
    "playwright": "^1.62.1",
    "postcss": "8.5.29",
    "prisma": "^5.12.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
