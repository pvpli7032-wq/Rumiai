{
  "name": "xingban-ai-community",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "db:init": "node scripts/initialize-db.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:community": "tsx prisma/seed-community.ts",
    "db:seed:site": "tsx prisma/seed-site.ts",
    "typecheck": "tsc --noEmit",
    "tasks:run": "node scripts/run-tasks.mjs",
    "admin:bootstrap": "node --import tsx scripts/bootstrap-admin.mjs",
    "account:password": "node --import tsx scripts/set-account-password.mjs",
    "story:publish": "node --import tsx scripts/publish-story-template.mjs",
    "release:check": "node --import tsx scripts/check-release.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "state:backup": "node scripts/backup-state.mjs",
    "state:restore": "node scripts/restore-state.mjs",
    "ops:closure-files": "node --import tsx scripts/retry-closure-files.mjs",
    "ops:health": "node --import tsx scripts/check-site-health.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "lucide-react": "0.468.0",
    "next": "15.5.27",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.29",
    "prisma": "^5.12.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
