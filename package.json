{
  "name": "xingban-ai-community",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "architecture:check": "node ops/architecture/check-boundaries.mjs",
    "architecture:routes": "node ops/architecture/route-inventory.mjs",
    "test:unit": "node --import tsx --test tests/unit/runtime-paths.test.mjs tests/unit/release-compatibility.test.mjs tests/unit/admin-cookies.test.ts tests/unit/environment.test.mjs",
    "test:memberships": "node tests/integration/run-memberships.mjs",
    "test:e2e:admin": "node --import tsx tests/e2e/admin-live-workflows.mjs",
    "test:e2e:membership": "node --import tsx tests/e2e/membership-paid-workflows.mjs",
    "test:restore": "node --import tsx --test tests/integration/isolated-state-restore.test.mjs",
    "test:startup": "node --import tsx --test tests/integration/production-startup.test.mjs",
    "test:migration-upgrade": "node tests/integration/migration-upgrade-validation.mjs",
    "pretest:memberships": "npm run db:generate",
    "dev": "node ops/runtime/run-apps.mjs dev",
    "build": "npm run build --workspace=@rumiai/api && npm run build --workspace=@rumiai/admin && npm run build --workspace=@rumiai/web",
    "prebuild": "npm run db:generate",
    "start": "node ops/scripts/start-production.mjs",
    "db:init": "node ops/scripts/initialize-db.mjs",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "db:seed": "tsx database/seed.ts",
    "db:seed:community": "tsx database/seed-community.ts",
    "db:seed:site": "tsx database/seed-site.ts",
    "typecheck": "tsc --noEmit",
    "test:worker": "node --experimental-default-type=module tests/integration/worker-runner.mjs",
    "test:tasks": "node --experimental-default-type=module tests/integration/tasks-runner-validation.mjs",
    "test:account-assets": "node --experimental-default-type=module --test --import tsx tests/integration/account-assets.test.ts",
    "tasks:run": "node --import tsx ops/scripts/run-tasks.mjs",
    "admin:bootstrap": "node --import tsx ops/scripts/bootstrap-admin.mjs",
    "account:password": "node --import tsx ops/scripts/set-account-password.mjs",
    "story:publish": "node --import tsx ops/scripts/publish-story-template.mjs",
    "release:check": "node --import tsx ops/scripts/check-release.mjs",
    "db:backup": "node ops/scripts/backup-db.mjs",
    "db:restore": "node ops/scripts/restore-db.mjs",
    "state:backup": "node ops/scripts/backup-state.mjs",
    "state:restore": "node ops/scripts/restore-state.mjs",
    "ops:closure-files": "node --import tsx ops/scripts/retry-closure-files.mjs",
    "ops:health": "node --import tsx ops/scripts/check-site-health.mjs"
  },
  "prisma": {
    "schema": "database/schema.prisma",
    "seed": "tsx database/seed.ts"
  },
  "dependencies": {
    "@next/env": "15.5.28",
    "@prisma/client": "^5.12.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "lucide-react": "0.468.0",
    "next": "15.5.28",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "^1.62.1",
    "postcss": "8.5.29",
    "prisma": "^5.12.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
